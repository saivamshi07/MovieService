# ==============================================================================
# Movie Service Environment Configuration (.env)
# Copy this file to .env and customize for local or production deployment
# ==============================================================================

# Server
SERVER_PORT=8082

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/movieServiceDB
DB_USERNAME=postgres
DB_PASSWORD=password
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT_MS=2000ms

# TMDB (The Movie Database) Credentials
# Get your API Read Access Token from: https://www.themoviedb.org/settings/api
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_BEARER_TOKEN=your_tmdb_v4_bearer_token_here
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Security & Shared Secrets
# 256-bit hexadecimal or Base64 secret key shared with user-service
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
GATEWAY_SHARED_SECRET=local-dev-gateway-secret

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MOVIE_RATING=movie.rating.v1

# Downstream Recommendation Service
RECOMMENDATION_SERVICE_URL=http://localhost:8083

# Background Pre-Warming
PREWARM_ENABLED=true
PREWARM_TOP_MOVIES_LIMIT=10
PREWARM_THROTTLE_DELAY_MS=250
